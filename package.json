{
  "name": "betafied",
  "version": "5.8.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint packs/BP/scripts",
    "test": "node --experimental-strip-types --import ./tests/mocks/register.mjs --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prebuild": "node scripts/pruneContentLogs.mjs",
    "build": "node scripts/regolith.mjs run",
    "release": "node scripts/release.mjs",
    "release:prepare": "node scripts/prepareRelease.mjs",
    "watch": "node scripts/watch.mjs",
    "logs:prune": "node scripts/pruneContentLogs.mjs",
    "logs:watch": "node scripts/pruneContentLogs.mjs --watch",
    "watch:regolith": "node scripts/regolith.mjs watch",
    "install-filters": "node scripts/regolith.mjs install-all",
    "docs:fetch": "node scripts/fetch-reference-docs.mjs",
    "generate:biomes": "node scripts/generate-biomes.mjs",
    "generate:client-biomes": "node scripts/generate-client-biomes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@minecraft/server": "2.11.0-beta.1.26.51-stable",
    "@minecraft/server-ui": "2.3.0-beta.1.26.51-stable",
    "@types/node": "^26.6.2",
    "eslint": "^10.0.0",
    "eslint-plugin-minecraft-linting": "^2.0.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "@minecraft/server": "$@minecraft/server"
  }
}
