      "textures": [ "Texture.default" ],
      "part_visibility": [
        { "*": false },
        { "rightArm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'" },
        { "rightSleeve": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'" },
        { "leftArm": "((query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged || (query.get_equipped_item_name(0, 1) == 'crossbow' && !query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0)))) && !(q.is_item_name_any('slot.weapon.mainhand', 'minecraft:bow') && query.main_hand_item_use_duration > 0.0f)" },
        { "leftSleeve": "((query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged || (query.get_equipped_item_name(0, 1) == 'crossbow' && !query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0)))) && !(q.is_item_name_any('slot.weapon.mainhand', 'minecraft:bow') && query.main_hand_item_use_duration > 0.0f)" }
