{
  "hud_player_renderer": {
    "ignored": true
  },
  "mob_effects_renderer": {
    "ignored": true
  },
  "horse_heart_renderer": {
    "ignored": true
  },
  "horse_jump_renderer": {
    "ignored": true
  },
  "dash_renderer": {
    "ignored": true
  },
  "locator_bar": {
    "ignored": true
  },
  "hunger_renderer": {
    "ignored": true
  },
  "root_panel": {
    "modifications": [
      { "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "chat_panel_bottom@bfui:hud_screen.chat_panel_bottom": {}},
          { "player_list@bfui:hud_screen.player_list": {}},
          { "underwater_tint@bfui:hud_screen.underwater_tint": {}}
      ]}
  ]},
  "chat_panel": {
    "bindings": [
      { "binding_name": "#hud_visible_centered_touch",
        "binding_type": "global",
        "binding_name_override": "#visible"
  }]},
  "hotbar_panel": {
    "controls": [
      { "left_pudding": {
          "type": "panel",
          "size": [20, 22],
          "bindings": [
            { "binding_name": "#hotbar_elipses_right_visible",
              "binding_name_override": "#visible",
              "binding_type": "global"
          }]
      }},
      { "hotbar_start_cap@hud.hotbar_start_cap": {}},
      { "hotbar_elipses_panel_left@hud.hotbar_elipses_panel_left_content": {}},
      { "hotbar_grid@hud.hotbar_grid": {}},
      { "hotbar_elipses_panel_right@hud.hotbar_elipses_panel_right_content": {}},
      { "hotbar_end_cap@hud.hotbar_end_cap": {}},
      { "right_pudding": {
          "type": "panel",
          "size": [20, 22],
          "bindings": [
            { "binding_name": "#hotbar_elipses_left_visible",
              "binding_name_override": "#visible",
              "binding_type": "global"
          }]
      }}
  ]},
  "hotbar_elipses_button": {
    "prevent_touch_input": true
  },
  "hud_title_text/title_frame": {
    "bindings": [
      { "binding_name": "#hud_title_text_string"},
      { "binding_type": "view",
        "source_property_name": "(not ('%.2s' * #hud_title_text_string = '_a') and (not ('%.2s' * #hud_title_text_string = '_w')))",
        "target_property_name": "#visible"
  }]},
  "custom_icon_core": {
    "type": "panel",
    "size": [ 8, 9 ],
    "$update_string": "_a",
    "$icon_value|default": 20,
    "$icon_value_half": "($icon_value - 1)",
    "controls": [
      { "data_control_core": {
          "type": "panel",
          "property_bag": {
            "#string_data": ""
          },
          "bindings": [
            { "binding_name": "#hud_title_text_string" },
            { "binding_name": "#hud_title_text_string",
              "binding_name_override": "#string_data",
              "binding_condition": "visibility_changed"
            },
            { "binding_type": "view",
              "source_property_name": "(not (#hud_title_text_string = #string_data) and (not ((#hud_title_text_string - $update_string) = #hud_title_text_string)))",
              "target_property_name": "#visible"
          }]
      }},
      { "icon_full": {
          "type": "image",
          "texture": "textures/ui/armor_full",
          "layer": 3,
          "size": [ 9, 9 ],
          "bindings": [
            { "binding_type": "view",
              "source_control_name": "data_control_core",
              "resolve_sibling_scope": true,
              "source_property_name": "((#string_data - $update_string) * 1)",
              "target_property_name": "#icon_value"
            },
            { "binding_type": "view",
              "source_property_name": "((#icon_value = $icon_value) or (#icon_value > $icon_value))",
              "target_property_name": "#visible"
          }]
      }},
      { "icon_half": {
          "type": "image",
          "texture": "textures/ui/armor_half",
          "layer": 2,
          "size": [ 9, 9 ],
          "bindings": [
            { "binding_type": "view",
              "source_control_name": "data_control_core",
              "resolve_sibling_scope": true,
              "source_property_name": "((#string_data - $update_string) * 1)",
              "target_property_name": "#icon_value"
            },
            { "binding_type": "view",
              "source_property_name": "(#icon_value = $icon_value_half)",
              "target_property_name": "#visible"
          }]
      }},
      { "icon_bg": {
          "type": "image",
          "texture": "textures/ui/armor_empty",
          "layer": 1,
          "size": [9, 9],
          "bindings": [
            { "binding_type": "view",
              "source_control_name": "data_control_core",
              "resolve_sibling_scope": true,
              "source_property_name": "((#string_data - $update_string) * 1)",
              "target_property_name": "#icon_value"
            },
            { "binding_type": "view",
              "source_property_name": "(not (#icon_value = 0))",
              "target_property_name": "#visible"
          }]
      }}
  ]},
  "armor_icon": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%c", 9],
    "controls": [
      { "1@hud.custom_icon_core": { "$icon_value": 20 }},
      { "2@hud.custom_icon_core": { "$icon_value": 18 }},
      { "3@hud.custom_icon_core": { "$icon_value": 16 }},
      { "4@hud.custom_icon_core": { "$icon_value": 14 }},
      { "5@hud.custom_icon_core": { "$icon_value": 12 }},
      { "6@hud.custom_icon_core": { "$icon_value": 10 }},
      { "7@hud.custom_icon_core": { "$icon_value": 8 }},
      { "8@hud.custom_icon_core": { "$icon_value": 6 }},
      { "9@hud.custom_icon_core": { "$icon_value": 4 }},
      { "10@hud.custom_icon_core": { "$icon_value": 2 }}
  ]},
  "hotbar_slot_image": {
    "$hotbar_slot_image_size|default": [20, 22],
    "type": "image",
    "offset": [0, 0],
    "size": "$hotbar_slot_image_size",
    "layer": 1,
    "alpha": 1
  },
  "item_durability@common.durability_bar": {
    "$durability_bar_required|default": true,
    "$item_collection_name": "$hotbar_collection_name",
    "offset": [ 0, 5.5 ]
  },
  "exp_progress_bar_and_hotbar": {
    "type": "panel",
    "size": [182, 31],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      { "hotbar@hotbar_chooser": {
          "offset": [4, 15.5],
          "bindings": [
            { "binding_name": "(not #is_spectator_mode)",
              "binding_name_override": "#visible"
          }]
      }}
  ]},
  "centered_gui_elements_at_bottom_middle": {
    "type": "panel",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [180, 50],
    "offset": [0, 2],
    "controls": [
      {
        "heart_rend@heart_renderer": {
          "offset": [-1, -33],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left"
        }
      },
      {
        "armor_rend@armor_icon": {
          "offset": [101, -25],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left"
        }
      },
      {
        "bubbles_rend_0@bubbles_renderer": {
          "offset": [180.5, -33],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_armor_visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not #is_armor_visible)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bubbles_rend_1@bubbles_renderer": {
          "offset": [180.5, -43],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_armor_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "exp_rend@exp_progress_bar_and_hotbar": {}
      }
    ]
  },
  "centered_gui_elements_at_bottom_middle_touch": {
    "type": "panel",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [180, 50],
    "offset": [0, 2],
    "controls": [
      {
        "heart_rend@heart_renderer": {
          "offset": [-1, -33],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left"
        }
      },
      {
        "armor_rend@armor_icon": {
          "offset": [101, -25],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left"
        }
      },
      {
        "bubbles_rend_0@bubbles_renderer": {
          "offset": [180.5, -33],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_armor_visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not #is_armor_visible)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bubbles_rend_1@bubbles_renderer": {
          "offset": [180.5, -43],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_armor_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "exp_rend@exp_progress_bar_and_hotbar": {}
      }
    ]
  }
}
