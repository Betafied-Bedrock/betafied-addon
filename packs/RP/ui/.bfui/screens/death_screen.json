{
  // Beta 1.7.3's GuiGameOver.drawScreen; both slots it fills route on $death_title, and values are pinned by deathScreenUi.test.ts.
  "namespace": "bfui-death_screen",

  // Router keyed on $death_title; layer 2 puts content above the background slot, and #enabled follows #visible so a hidden branch cannot take clicks.
  "form_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 2,
    "$death_title": "Game over!",
    "controls": [
      {
        "death_screen@bfui-death_screen.root_panel": {
          // Hidden until the title binding runs, or this tree draws on every other pack's first frame.
          "visible": false,
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = $death_title)",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "#visible",
              "target_property_name": "#enabled"
            }
          ]
        }
      },
      {
        "other_form@server_form.long_form": {
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(not (#title_text = $death_title))",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "#visible",
              "target_property_name": "#enabled"
            }
          ]
        }
      }
    ]
  },

  // The era's two text rows and buttons; everything under them lives in screen_underlay, outside the safezone inset.
  "root_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "title@bfui-death_screen.title": {} },
      { "score@bfui-death_screen.score": {} },
      { "button_layout@bfui-death_screen.button_layout": {} }
    ]
  },

  // Era paint order (HUD, then wash) in the background slot, the one rect outside the safezone; its empty default is what other forms see.
  "screen_underlay": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$death_title": "Game over!",
    "controls": [
      {
        "death_underlay": {
          "type": "panel",
          "size": [ "100%", "100%" ],
          "controls": [
            { "hud@bfui-death_screen.hud": {} },
            { "wash@bfui-death_screen.wash": {} }
          ],
          // Same title guard: the slot is shared, so an unguarded wash flashes on every other pack's form.
          "visible": false,
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = $death_title)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  // 0x60500000 -> 0xA0803030 baked to a texture: ui_fill_gradient is re-blended for the crosshair, so a gradient_renderer here would filter the world.
  "wash": {
    "type": "image",
    "texture": "textures/ui/death_gradient",
    "size": [ "100%", "100%" ],
    "keep_ratio": false,
    "fill": true
  },

  // renderGameOverlay's order; the wash above is drawn last and tints it.
  "hud": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "hotbar@bfui-death_screen.hotbar": {} },
      { "hotbar_selector@bfui-death_screen.hotbar_selector": {} },
      {
        "heart_0@bfui-death_screen.heart": {
          "offset": [ -86.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_a" ] } } ]
        }
      },
      {
        "heart_1@bfui-death_screen.heart": {
          "offset": [ -78.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_b" ] } } ]
        }
      },
      {
        "heart_2@bfui-death_screen.heart": {
          "offset": [ -70.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_c" ] } } ]
        }
      },
      {
        "heart_3@bfui-death_screen.heart": {
          "offset": [ -62.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_a" ] } } ]
        }
      },
      {
        "heart_4@bfui-death_screen.heart": {
          "offset": [ -54.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_b" ] } } ]
        }
      },
      {
        "heart_5@bfui-death_screen.heart": {
          "offset": [ -46.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_c" ] } } ]
        }
      },
      {
        "heart_6@bfui-death_screen.heart": {
          "offset": [ -38.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_a" ] } } ]
        }
      },
      {
        "heart_7@bfui-death_screen.heart": {
          "offset": [ -30.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_b" ] } } ]
        }
      },
      {
        "heart_8@bfui-death_screen.heart": {
          "offset": [ -22.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_c" ] } } ]
        }
      },
      {
        "heart_9@bfui-death_screen.heart": {
          "offset": [ -14.5, -23 ],
          "controls": [ { "heart_sprite@bfui-death_screen.heart_sprite": { "anims": [ "@bfui-death_screen.heart_jitter_a" ] } } ]
        }
      },
      { "crosshair_arm_horizontal@bfui-death_screen.crosshair_pixel": { "size": [ 9, 1 ] } },
      { "crosshair_arm_vertical@bfui-death_screen.crosshair_pixel": { "size": [ 1, 9 ] } },
      { "crosshair_centre@bfui-death_screen.crosshair_pixel": { "size": [ 1, 1 ] } }
    ]
  },

  // uv_size is required or the engine maps the whole sheet; the selection frame stays on slot 0, the one HUD value a form screen cannot bind.
  "hotbar": {
    "type": "image",
    "texture": "textures/gui/gui",
    "uv": [ 0, 0 ],
    "uv_size": [ 182, 22 ],
    "size": [ 182, 22 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle"
  },

  "hotbar_selector": {
    "type": "image",
    "texture": "textures/gui/gui",
    "uv": [ 0, 22 ],
    "uv_size": [ 24, 22 ],
    "size": [ 24, 22 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ -80, -1 ]
  },

  // Era's 8px pitch with 9px sprites (hence half-pixel x); the slot carries x so the offset animation can only jitter y.
  "heart": {
    "type": "panel",
    "size": [ 9, 9 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      { "heart_sprite@bfui-death_screen.heart_sprite": {} }
    ]
  },

  "heart_sprite": {
    "type": "image",
    "texture": "textures/gui/icons",
    "uv": [ 16, 0 ],
    "uv_size": [ 9, 9 ],
    "size": [ 9, 9 ],
    "anims": [ "@bfui-death_screen.heart_jitter_a" ]
  },

  // The era re-rolls a 0-or-1px drop per slot each tick from an RNG no animation can replay; three staggered 1px loops read the same.
  "heart_jitter_a": {
    "anim_type": "offset",
    "easing": "linear",
    "duration": 0.05,
    "from": [ 0, 0 ],
    "to": [ 0, 1 ],
    "next": "@bfui-death_screen.heart_jitter_a"
  },

  // Spelled out because next inherits too: a copy would chain into jitter_a and stop being its own loop.
  "heart_jitter_b": {
    "anim_type": "offset",
    "easing": "linear",
    "duration": 0.065,
    "from": [ 0, 0 ],
    "to": [ 0, 1 ],
    "next": "@bfui-death_screen.heart_jitter_b"
  },

  "heart_jitter_c": {
    "anim_type": "offset",
    "easing": "linear",
    "duration": 0.08,
    "from": [ 0, 0 ],
    "to": [ 0, 1 ],
    "next": "@bfui-death_screen.heart_jitter_c"
  },

  // Difference blend inverts the world; gradient_renderer is the only control drawn through the material the pack re-blends for it.
  "crosshair_pixel": {
    "type": "custom",
    "renderer": "gradient_renderer",
    "color1": [ 1, 1, 1, 1 ],
    "color2": [ 1, 1, 1, 1 ],
    "size": [ 1, 1 ],
    "anchor_from": "center",
    "anchor_to": "center"
  },

  // glScalef(2,2,2) at y=30: baseline 60, glyph box top 44.
  "title": {
    "type": "label",
    "size": [ "100%", "default" ],
    "text": "#title_text",
    "color": [ 1, 1, 1, 1 ],
    "font_type": "default",
    "font_scale_factor": 2.0,
    "shadow": true,
    "localize": false,
    "text_alignment": "center",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 44 ],
    "bindings": [
      { "binding_name": "#title_text" }
    ]
  },

  // Baseline 100 (box 92); '&e' printed literally in the era, and the property-bag default keeps the body when no binding runs.
  "score": {
    "type": "label",
    "size": [ "100%", "default" ],
    "property_bag": {
      "#form_text": "Score: &e0"
    },
    "text": "#form_text",
    "color": [ 1, 1, 1, 1 ],
    "font_type": "default",
    "shadow": true,
    "localize": false,
    "text_alignment": "center",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 92 ],
    "bindings": [
      { "binding_name": "#form_text" }
    ]
  },

  // height / 4 + 72, as 25% of the parent plus the era's 72 (asymmetric anchors resolve backwards here).
  "button_layout": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, "25%" ],
    "controls": [
      { "era_offset": { "type": "panel", "size": [ "0px", "72px" ] } },
      { "buttons@bfui-death_screen.form_buttons": {} }
    ]
  },

  // The engine's form_buttons collection, so a click arrives as a form response.
  "form_buttons": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "bfui-death_screen.button_item"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  // 24px pitch around a 20px button: initGui places them at height / 4 + 72 and + 96.
  "button_item": {
    "type": "panel",
    "size": [ "100%", 24 ],
    "controls": [
      { "button@bfui-death_screen.button": {} }
    ]
  },

  // GuiButton at 200x20; the textures are the pack's crops of the era's widget rows.
  "button@common_buttons.light_text_button": {
    "$button_type_panel": "bfui-death_screen.button_label",
    "$pressed_button_name": "button.form_button_click",
    "$button_text": "#form_button_text",
    "$button_text_binding_type": "collection",
    "$button_text_grid_collection_name": "form_buttons",
    "$default_button_texture": "textures/ui/vanilla_default",
    "$hover_button_texture": "textures/ui/vanilla_pressed",
    "$pressed_button_texture": "textures/ui/vanilla_pressed",
    "$locked_button_texture": "textures/ui/vanilla_locked",
    // GuiButton.drawButton colours: 14737632 enabled, 16777120 hovered, -6250336 disabled.
    "$default_text_color": [ 0.87843137, 0.87843137, 0.87843137, 1 ],
    "$hover_text_color": [ 1, 1, 0.62745098, 1 ],
    "$pressed_text_color": [ 1, 1, 0.62745098, 1 ],
    "$locked_text_color": [ 0.62745098, 0.62745098, 0.62745098, 1 ],
    "$font_type": "default",
    "$button_image_size": [ "100%", "100%" ],
    "$border_visible": false,
    "$border_alpha": 0,
    "$button_pressed_offset": [ 0, 0 ],
    "size": [ 200, 20 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    // Binds each item to its own row, so #form_button_text resolves per button.
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "button_label@common_buttons.new_ui_binding_button_label": {
    "shadow": true
  }
}
