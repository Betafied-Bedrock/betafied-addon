{ "content_panel": {
    "type": "panel",
    // "ignored": true,
    "controls": [
      {
        "label_01": {
          "type": "label",
          "text": "Assets and gameplay currently in development",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "alpha": 0.35,
          "offset": [ -10, 8 ]
        }
      },
      {
        "label_02": {
          "type": "label",
          "text": "Gameplay is not final. expect some changes.",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "alpha": 0.35,
          "offset": [ -10, 18 ]
        }
      },
      {
        "label_03": {
          "type": "label",
          "text": "$screen_content",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "alpha": 0.35,
          "offset": [ -10, 32 ]
        }
      }
    ]
}}


