{
  "namespace": "server_form",

  // Wholesale replacement (a modifications patch throws "Type not specified"); animations emptied for the instant exit, shared background slot routed by title.
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "$screen_bg_content": "bfui-death_screen.screen_underlay",
    "$screen_animations": [],
    "$background_animations": [],
    "$use_loading_bars": false,
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },

  // Keeps the factory (it carries the form's data context) and swaps the tree for form_root, so other packs keep server_form.long_form.
  "main_screen_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@bfui-death_screen.form_root",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  }
}
