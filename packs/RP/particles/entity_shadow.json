{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "bh:entity_shadow",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/particle/entity_shadow"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": false
            },
            "minecraft:emitter_lifetime_expression": {
                "activation_expression": "1",
                "expiration_expression": "0"
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": "20",
                "max_particles": 1
            },
            "minecraft:emitter_shape_point": {
                "offset": [
                    0,
                    0.02,
                    0
                ]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "1000000"
            },
            "minecraft:particle_initial_speed": 0,
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    0,
                    "math.min(0.02, query.property('betarock:shadow_ground') - query.position(1) + 0.02)",
                    0
                ]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "variable.shadow_span",
                    "variable.shadow_span"
                ],
                "facing_camera_mode": "emitter_transform_xz",
                "uv": {
                    "texture_width": 64,
                    "texture_height": 64,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        64,
                        64
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    "1",
                    "1",
                    "1",
                    "math.max(variable.shadow_alpha * (1 - query.distance_from_camera * query.distance_from_camera / 256), 0)"
                ]
            }
        }
    }
}
