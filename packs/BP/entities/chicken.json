{
  "format_version": "1.21.70",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:chicken",
      "properties": {
          "betarock:shadow_span": { "type": "float", "range": [0.0, 4.0], "default": 0.3, "client_sync": true },
          "betarock:shadow_alpha": { "type": "float", "range": [0.0, 1.0], "default": 0.45, "client_sync": true },
